{
  "identifier": "desktop-commands",
  "description": "Allow Cinny's main window to send desktop notifications and configure desktop preferences and push-to-talk.",
  "local": true,
  "remote": {
    "urls": ["http://localhost:44548/*"]
  },
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "allow-show-desktop-notification",
    "allow-set-push-to-talk-binds",
    "allow-get-quit-on-close",
    "allow-set-quit-on-close"
  ]
}
